SECRET_KEY=change-in-production-django-insecure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.herokuapp.com

# Database (Default uses SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://user:password@localhost:5432/outdoora_db

# CORS configuration for Next.js frontend and React Native
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS S3 Storage for Tour GPX tracks & photos (Outdoora Cloud Stack)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=outdoora-tour-assets
AWS_S3_REGION_NAME=eu-south-1
